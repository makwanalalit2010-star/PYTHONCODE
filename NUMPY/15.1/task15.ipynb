   "source": [
    "# Task 15: Create a 1D NumPy array of 10 elements. Use boolean indexing to filter out all values greater than 5.\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "arr = np.array([1,8,7,5,4,3,2,3,4,5,6,7,10])\n",
    "\n",
    "result = arr[arr <= 5]\n",
    "\n",
    "print(result)"
   ]
  }
