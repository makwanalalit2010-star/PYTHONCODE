   "source": [
    "# Task 11: Create a 1D NumPy array with values ranging from 1 to 15. Slice the array to extract elements from index 3 to 8.\n",
    "\n",
    "import numpy as np\n",
    "arr = np.arange(1, 16)\n",
    "\n",
    "result = arr[3:9]\n",
    "\n",
    "print(\"orginal array:\", arr)\n",
    "print(\"sliced array:\", result)\n"
   ]
  }
