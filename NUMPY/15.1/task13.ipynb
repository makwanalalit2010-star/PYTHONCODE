   "source": [
    "# Task 13: Slice a 4x4 array to extract the last two rows and the last two columns\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "arr = np.arange(1, 17).reshape(4, 4)\n",
    "print(arr)\n",
    "\n",
    "result = arr[-2:, -2:]\n",
    "print(result)"
   ]
  }
