    "# Task 12: Generate a 3x3 matrix with values ranging from 1 to 9. Retrieve the element at the second row and third column.\n",
    "import numpy as np\n",
    "\n",
    "arr = np.arange(1,10).reshape(3,3)\n",
    "print(arr)\n",
    "\n",
    "result = arr[1, 2]\n",
    "print(result)"
