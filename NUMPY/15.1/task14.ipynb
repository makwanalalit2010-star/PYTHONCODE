   "source": [
    "# Task 14: Create a 5x5 matrix of random integers between 10 and 50. Replace all elements in the first row with the value 100.\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "arr = np.random.randint(10, 51, size=(5, 5))\n",
    "\n",
    "print(\"before:\")\n",
    "print(arr)\n",
    "\n",
    "arr[0, :] = 100\n",
    "\n",
    "print(\"after:\")\n",
    "print(arr)\n"
   ]
  }
