   "source": [
    "# 3. Create a 2D array and split it into 4 equal sub-arrays.\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "arr = np.arange(1, 17).reshape(4, 4)\n",
    "\n",
    "print(\"original array:\")\n",
    "print(arr)\n",
    "\n",
    "result = np.vsplit(arr, 4)\n",
    "\n",
    "print(\"\\nsub-arrays:\")\n",
    "for x in result:\n",
    "     print(x)\n"
   ]
  }
