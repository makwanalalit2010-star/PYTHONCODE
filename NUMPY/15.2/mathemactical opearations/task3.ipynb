   "source": [
    "# 3. Create a NumPy array and apply trigonometric operations like sin, cos, and tan.\n",
    "\n",
    "import numpy as np \n",
    "\n",
    "arr = np.array([0, np.pi/4, np.pi/2])\n",
    "\n",
    "print(\"array:\")\n",
    "print(arr)\n",
    "\n",
    "print(\"sin:\")\n",
    "print(np.sin(arr))\n",
    "\n",
    "print(\"cos:\")\n",
    "print(\"np.cos(arr)\")\n",
    "\n",
    "print(\"tan:\")\n",
    "print(np.tan(arr))\n",
    "\n"
   ]
  }
